// use prisma-next

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String?
  name         String?
  passwordHash String
  posts        Post[]
  sessions     Session[]
  cart         Cart?
  orders       Order[]
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Session {
  id        String   @id
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())
}

model Material {
  id          Int      @id @default(autoincrement())
  title       String
  subtitle    String
  price       String?
  tag         String?
  type        String
  action      String
  href        String?
  imageUrl    String?
  cartItems   CartItem[]
  orderItems  OrderItem[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Cart {
  id        Int        @id @default(autoincrement())
  user      User       @relation(fields: [userId], references: [id])
  userId    Int        @unique
  items     CartItem[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model CartItem {
  id         Int      @id @default(autoincrement())
  cart       Cart     @relation(fields: [cartId], references: [id])
  cartId     Int
  material   Material @relation(fields: [materialId], references: [id])
  materialId Int
  quantity   Int      @default(1)
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  @@unique([cartId, materialId])
}

model Order {
  id        Int         @id @default(autoincrement())
  user      User        @relation(fields: [userId], references: [id])
  userId    Int
  status    String      @default("pending")
  firstName String
  lastName  String
  email     String
  phone     String
  total     String
  items     OrderItem[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model OrderItem {
  id         Int         @id @default(autoincrement())
  order      Order       @relation(fields: [orderId], references: [id])
  orderId    Int
  material   Material    @relation(fields: [materialId], references: [id])
  materialId Int
  title      String
  price      String
  quantity   Int
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
}